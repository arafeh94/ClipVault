<!-- Settings page shown inside the clipboard panel (the gear button). Changes apply immediately. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="{DynamicResource UiFont}"
      TextElement.FontSize="14"
      TextElement.Foreground="{DynamicResource FgBrush}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="-6,0,0,0">
        <Button x:Name="Back" Style="{DynamicResource IconButton}" Content="&#xE72B;" ToolTip="Back (Esc)" />
        <TextBlock Text="Settings" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,-10,0">
        <StackPanel Margin="0,0,10,12">

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindows" Content="Start with Windows" />
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="-12,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="History size" />
                            <TextBlock Text="Pinned items don't count" FontSize="12" Foreground="{DynamicResource Fg3Brush}" />
                        </StackPanel>
                        <TextBox x:Name="MaxItems" Grid.Column="1" Width="80" HorizontalContentAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="-12,10" />
                    <TextBlock Text="Size" />
                    <TextBlock Text="Text, icons and the panel together" FontSize="12" Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,4" />
                    <StackPanel x:Name="SizeOptions" Orientation="Horizontal" Margin="-10,0,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Tags" />
                    <TextBlock Text="Deleting a tag keeps its items pinned" FontSize="12" Foreground="{DynamicResource Fg3Brush}" Margin="0,0,0,4" />
                    <StackPanel x:Name="TagList" />
                </StackPanel>
            </Border>

            <!-- Sync: pinned text, tags and folders through ClipVault's sync server. Off until switched on; manual Push / Pull. -->
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                <StackPanel>
                    <CheckBox x:Name="SyncEnabledBox" Content="Sync between PCs" />
                    <TextBlock Text="Pinned text, tags and folders. Nothing is sent until you press Push or Pull."
                               FontSize="12" Foreground="{DynamicResource Fg3Brush}" TextWrapping="Wrap" Margin="0,2,0,0" />

                    <StackPanel x:Name="SyncBody" Margin="0,8,0,0">
                        <!-- 1. Account -->
                        <StackPanel x:Name="SyncAccountPanel">
                            <TextBox x:Name="SyncEmailBox" Tag="Email" />
                            <PasswordBox x:Name="SyncPassword" Margin="0,6,0,0" ToolTip="Password (at least 6 characters)" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SyncSignIn" Style="{DynamicResource TextButton}" Content="Sign in" />
                                <Button x:Name="SyncCreate" Style="{DynamicResource TextButton}" Content="Create account" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 2. Optional encryption passphrase (first PC, or when changing it) -->
                        <StackPanel x:Name="SyncChoosePanel">
                            <TextBlock x:Name="SyncChooseTitle" TextWrapping="Wrap" />
                            <TextBlock Text="Leave it empty to sync without encryption (readable on the server). With a passphrase, only your PCs can read your data; it can't be recovered if you forget it."
                                       FontSize="12" Foreground="{DynamicResource Fg3Brush}" TextWrapping="Wrap" Margin="0,2,0,6" />
                            <PasswordBox x:Name="SyncPass1" ToolTip="Encryption passphrase (optional)" />
                            <PasswordBox x:Name="SyncPass2" Margin="0,6,0,0" ToolTip="Repeat the passphrase" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SyncChooseOk" Style="{DynamicResource TextButton}" Content="Continue" />
                                <Button x:Name="SyncChooseCancel" Style="{DynamicResource TextButton}" Content="Cancel" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 3. Unlock an encrypted account on this PC -->
                        <StackPanel x:Name="SyncUnlockPanel">
                            <TextBlock Text="Your synced data is encrypted. Enter your sync passphrase." TextWrapping="Wrap" />
                            <PasswordBox x:Name="SyncUnlockPass" Margin="0,6,0,0" ToolTip="Sync passphrase" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SyncUnlock" Style="{DynamicResource TextButton}" Content="Unlock" />
                                <Button x:Name="SyncUnlockSignOut" Style="{DynamicResource TextButton}" Content="Unlink this PC" Margin="6,0,0,0"
                                        ToolTip="Stop syncing this PC with this account. Your items stay here." />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4. Ready -->
                        <StackPanel x:Name="SyncReadyPanel">
                            <TextBlock x:Name="SyncWho" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SyncPush" Style="{DynamicResource TextButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                                        <TextBlock Text="Push" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SyncPull" Style="{DynamicResource TextButton}" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                                        <TextBlock Text="Pull" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SyncSignOut" Style="{DynamicResource TextButton}" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- the link icon with a slash through it (the icon font has no unlink symbol) -->
                                        <Grid Width="15" Height="15" VerticalAlignment="Center" Margin="0,1,8,0">
                                            <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Line X1="1.5" Y1="1.5" X2="13.5" Y2="13.5" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Grid>
                                        <TextBlock Text="Unlink" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border x:Name="SyncConfirm" Visibility="Collapsed" Background="{DynamicResource InputBrush}" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="SyncPreview" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button x:Name="SyncCancel" Style="{DynamicResource TextButton}" Content="Cancel" />
                                        <Button x:Name="SyncConfirmButton" Style="{DynamicResource TextButton}" Content="Confirm" Margin="6,0,0,0"
                                                Background="{DynamicResource AccentFillBrush}" Foreground="White" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SyncChangeEnc" Style="{DynamicResource Crumb}" Foreground="{DynamicResource Fg2Brush}" Margin="-6,0,0,0" />
                                <Button x:Name="SyncDeleteAccount" Style="{DynamicResource Crumb}" Foreground="{DynamicResource Fg2Brush}" Content="Delete account" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="SyncStatus" FontSize="12" Foreground="{DynamicResource Fg3Brush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Ask Claude folder" />
                    <TextBlock Text="claude --continue runs here, so it resumes the latest conversation from this folder" FontSize="12"
                               Foreground="{DynamicResource Fg3Brush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClaudeFolder" />
                        <Button x:Name="Browse" Grid.Column="1" Style="{DynamicResource IconButton}" Content="&#xE8DA;" Margin="4,0,0,0" ToolTip="Choose folder" />
                    </Grid>
                    <TextBlock x:Name="ClaudeStatus" FontSize="12" Foreground="{DynamicResource Fg3Brush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Stored data" />
                        <TextBlock x:Name="DataInfo" FontSize="12" Foreground="{DynamicResource Fg3Brush}" />
                    </StackPanel>
                    <Button x:Name="OpenData" Grid.Column="1" Style="{DynamicResource IconButton}" Content="&#xE838;" ToolTip="Open data folder" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Grid>
